<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sonic Fusion - DJ Mixer Pro</title>
  <style>
    :root {
      --bg-color: radial-gradient(circle at center, #111 0%, #000 100%);
      --neon-cyan: #0ff;
      --neon-green: #0f0;
      --neon-pink: #f0f;
      --neon-red: #ff3333;
    }

    body {
      margin: 0;
      background: var(--bg-color);
      color: #fff;
      font-family: 'Segoe UI', sans-serif;
      text-align: center;
      padding: 20px;
    }

    /* Tela de Capa Interativa */
    #coverScreen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)), url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=1200&auto=format&fit=crop') no-repeat center center/cover;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      transition: opacity 0.5s ease;
    }

    .cover-card {
      background: rgba(20, 20, 20, 0.85);
      border: 2px solid var(--neon-cyan);
      box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
      border-radius: 20px;
      padding: 40px;
      max-width: 500px;
      width: 90%;
      backdrop-filter: blur(10px);
    }

    .cover-card h1 {
      color: var(--neon-cyan);
      text-shadow: 0 0 15px var(--neon-cyan);
      font-size: 2.2rem;
      margin-bottom: 5px;
      letter-spacing: 2px;
    }

    .cover-card p {
      color: #aaa;
      font-size: 1rem;
      margin-bottom: 30px;
    }

    .cover-buttons {
      display: flex;
      justify-content: space-around;
      gap: 15px;
      flex-wrap: wrap;
    }

    .neon-btn {
      background: transparent;
      border: 2px solid;
      padding: 15px 25px;
      border-radius: 50px;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex: 1;
      min-width: 110px;
    }

    .btn-preview {
      border-color: var(--neon-green);
      color: var(--neon-green);
      box-shadow: 0 0 10px rgba(0, 255, 0, 0.2);
    }
    .btn-preview:hover {
      background: var(--neon-green);
      color: #000;
      box-shadow: 0 0 20px var(--neon-green);
      transform: scale(1.05);
    }

    .btn-start {
      border-color: var(--neon-red);
      color: var(--neon-red);
      box-shadow: 0 0 10px rgba(255, 51, 51, 0.2);
    }
    .btn-start:hover {
      background: var(--neon-red);
      color: #fff;
      box-shadow: 0 0 20px var(--neon-red);
      transform: scale(1.05);
    }

    .btn-record {
      border-color: var(--neon-pink);
      color: var(--neon-pink);
      box-shadow: 0 0 10px rgba(255, 0, 255, 0.2);
    }
    .btn-record:hover {
      background: var(--neon-pink);
      color: #fff;
      box-shadow: 0 0 20px var(--neon-pink);
      transform: scale(1.05);
    }

    /* Aplicação Principal (Oculta Inicialmente) */
    #appContent {
      display: none;
    }

    h1.app-title {
      color: var(--neon-cyan);
      text-shadow: 0 0 10px var(--neon-cyan);
      margin-bottom: 30px;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: auto;
    }

    .deck {
      background: rgba(30, 30, 30, 0.8);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.2);
      backdrop-filter: blur(6px);
    }

    h2 {
      color: var(--neon-green);
      margin-bottom: 10px;
    }

    input[type="range"], select {
      width: 100%;
      margin: 5px 0;
    }

    button.control-btn {
      background: linear-gradient(45deg, var(--neon-green), var(--neon-cyan));
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      color: #000;
      font-weight: bold;
      margin: 5px;
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    button.control-btn:hover { transform: scale(1.05); }

    .waveform, canvas {
      margin-top: 10px;
      border-radius: 6px;
      background: #222;
      width: 100%;
    }
    .waveform { height: 80px; }
    canvas { height: 100px; }
    .time { font-size: 14px; color: #aaa; margin-top: 5px; }
    .crossfader { margin-top: 40px; }
    
    #downloadLink {
      display: none;
      margin-top: 10px;
      color: var(--neon-cyan);
      text-decoration: underline;
    }
  </style>
  <!-- WaveSurfer.js V7 -->
  <script src="https://unpkg.com/wavesurfer.js@7"></script>
</head>
<body>

  <!-- Capa Estilo Mixagem com Botões Clicáveis -->
  <div id="coverScreen">
    <div class="cover-card">
      <h1>SONIC FUSION</h1>
      <p>THE ART OF MIXING - LIVE SESSIONS</p>
      <div class="cover-buttons">
        <button class="neon-btn btn-preview" onclick="launchApp('preview')">
          <span>🎧</span> Pré-escuta
        </button>
        <button class="neon-btn btn-start" onclick="launchApp('start')">
          <span>▶️</span> Iniciar Mixagem
        </button>
        <button class="neon-btn btn-record" onclick="launchApp('record')">
          <span>🔴</span> Gravar
        </button>
      </div>
    </div>
  </div>

  <!-- Interface do Aplicativo de Mixagem -->
  <div id="appContent">
    <h1 class="app-title">🎧 Sonic Fusion - DJ Mixer Studio</h1>

    <div class="container">
      <!-- Deck A -->
      <div class="deck" id="deckA">
        <h2>Deck A</h2>
        <input type="file" accept="audio/*" onchange="loadTrack(this, 'A')">
        <br>
        <button class="control-btn" onclick="play('A')">▶️ Play</button>
        <button class="control-btn" onclick="pause('A')">⏸️ Pause</button>
        <button class="control-btn" onclick="setCue('A')">🎯 Cue</button>
        <button class="control-btn" onclick="goToCue('A')">⏪ Go Cue</button>
        <button class="control-btn" onclick="startLoop('A')">🔁 Loop</button>
        <button class="control-btn" onclick="stopLoop('A')">⏹️ Stop</button>
        
        <label>Volume</label>
        <input type="range" min="0" max="1" step="0.01" value="1" oninput="setVolume(this.value, 'A')">
        <label>Pitch</label>
        <input type="range" min="0.5" max="2" step="0.01" value="1" oninput="setPitch(this.value, 'A')">
        <label>Graves</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','low',this.value)">
        <label>Médios</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','mid',this.value)">
        <label>Agudos</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','high',this.value)">
        
        <div id="waveA" class="waveform"></div>
        <canvas id="spectrumA"></canvas>
        <div id="timeA" class="time">00:00 / 00:00</div>
      </div>

      <!-- Deck B -->
      <div class="deck" id="deckB">
        <h2>Deck B</h2>
        <input type="file" accept="audio/*" onchange="loadTrack(this, 'B')">
        <br>
        <button class="control-btn" onclick="play('B')">▶️ Play</button>
        <button class="control-btn" onclick="pause('B')">⏸️ Pause</button>
        <button class="control-btn" onclick="setCue('B')">🎯 Cue</button>
        <button class="control-btn" onclick="goToCue('B')">⏪ Go Cue</button>
        <button class="control-btn" onclick="startLoop('B')">🔁 Loop</button>
        <button class="control-btn" onclick="stopLoop('B')">⏹️ Stop</button>
        
        <label>Volume</label>
        <input type="range" min="0" max="1" step="0.01" value="1" oninput="setVolume(this.value, 'B')">
        <label>Pitch</label>
        <input type="range" min="0.5" max="2" step="0.01" value="1" oninput="setPitch(this.value, 'B')">
        <label>Graves</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','low',this.value)">
        <label>Médios</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','mid',this.value)">
        <label>Agudos</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','high',this.value)">
        
        <div id="waveB" class="waveform"></div>
        <canvas id="spectrumB"></canvas>
        <div id="timeB" class="time">00:00 / 00:00</div>
      </div>
    </div>

    <!-- Crossfader -->
    <div class="deck crossfader">
      <h2>🎚️ Crossfader</h2>
      <input type="range" id="xfader" min="0" max="1" step="0.01" value="0.5" oninput="crossfade(this.value)">
      <label>Curva:</label>
      <select id="curve" onchange="crossfade(document.getElementById('xfader').value)">
        <option value="linear">Linear</option>
        <option value="exponential">Exponencial</option>
        <option value="log">Logarítmica</option>
        <option value="s">Curva em S</option>
      </select>
    </div>

    <!-- Painel de Efeitos -->
    <div class="deck">
      <h2>🎧 Painel de Efeitos (DSP FX)</h2>
      <label>Deck Alvo:</label>
      <select id="fxDeck">
        <option value="A">Deck A</option>
        <option value="B">Deck B</option>
      </select>
      <button class="control-btn" onclick="sweepFilter(getFXDeck())">🌊 Sweep Filter</button>
      <button class="control-btn" onclick="addReverb(getFXDeck())">🌫️ Reverb</button>
      <button class="control-btn" onclick="addDelay(getFXDeck())">⏱️ Delay</button>
    </div>

    <!-- Gravação -->
    <div class="deck">
      <h2>🎙️ Gravação da Sessão</h2>
      <button class="control-btn" onclick="startRecording()">🔴 Iniciar Gravação</button>
      <button class="control-btn" onclick="stopRecording()">⏹️ Parar Gravação</button>
      <br>
      <a id="downloadLink"></a>
    </div>
  </div>

  <script>
    let audioCtx = null;
    const deckNodes = { A: {}, B: {} };
    const eqNodes = { A: {}, B: {} };
    let cuePoints = { A: 0, B: 0 };
    let loopIntervals = { A: null, B: null };

    const wavesurferA = WaveSurfer.create({ container: '#waveA', waveColor: '#0f0', progressColor: '#0ff', height: 80, crossorigin: 'anonymous' });
    const wavesurferB = WaveSurfer.create({ container: '#waveB', waveColor: '#f00', progressColor: '#ff0', height: 80, crossorigin: 'anonymous' });

    // Função para transitar da Capa para a Aplicação Principal
    function launchApp(action) {
      document.getElementById('coverScreen').style.opacity = '0';
      setTimeout(() => {
        document.getElementById('coverScreen').style.display = 'none';
        document.getElementById('appContent').style.display = 'block';
        initAudioContext();
        
        if (action === 'start') {
          // Ação direta ao iniciar
        } else if (action === 'record') {
          setTimeout(startRecording, 500);
        }
      }, 500);
    }

    function initAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        initDeck("A", wavesurferA, "timeA");
        initDeck("B", wavesurferB, "timeB");
      } else if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function initDeck(deck, wavesurfer, timeId) {
      deckNodes[deck].gain = audioCtx.createGain();
      deckNodes[deck].analyser = audioCtx.createAnalyser();
      deckNodes[deck].analyser.fftSize = 256;

      eqNodes[deck].low = audioCtx.createBiquadFilter();
      eqNodes[deck].low.type = "lowshelf";
      eqNodes[deck].low.frequency.value = 200;

      eqNodes[deck].mid = audioCtx.createBiquadFilter();
      eqNodes[deck].mid.type = "peaking";
      eqNodes[deck].mid.frequency.value = 1000;

      eqNodes[deck].high = audioCtx.createBiquadFilter();
      eqNodes[deck].high.type = "highshelf";
      eqNodes[deck].high.frequency.value = 5000;

      const mediaElement = wavesurfer.getMediaElement();
      if (mediaElement) {
        const src = audioCtx.createMediaElementSource(mediaElement);
        src.connect(eqNodes[deck].low);
        eqNodes[deck].low.connect(eqNodes[deck].mid);
        eqNodes[deck].mid.connect(eqNodes[deck].high);
        eqNodes[deck].high.connect(deckNodes[deck].gain);
        deckNodes[deck].gain.connect(deckNodes[deck].analyser);
        deckNodes[deck].analyser.connect(audioCtx.destination);
      }

      wavesurfer.on('audioprocess', () => updateTime(deck, timeId));
      wavesurfer.on('seeking', () => updateTime(deck, timeId));
      wavesurfer.on('ready', () => updateTime(deck, timeId));

      drawSpectrum(deckNodes[deck].analyser, "spectrum" + deck);
    }

    function formatTime(seconds) {
      const minutes = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function updateTime(deck, timeId) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      const current = ws.getCurrentTime() || 0;
      const duration = ws.getDuration() || 0;
      document.getElementById(timeId).textContent = `${formatTime(current)} / ${formatTime(duration)}`;
    }

    function loadTrack(input, deck) {
      initAudioContext();
      const file = input.files[0];
      if (file) {
        const url = URL.createObjectURL(file);
        if (deck === "A") wavesurferA.load(url);
        else wavesurferB.load(url);
      }
    }

    function play(deck) {
      initAudioContext();
      (deck === "A" ? wavesurferA : wavesurferB).play();
    }

    function pause(deck) {
      (deck === "A" ? wavesurferA : wavesurferB).pause();
    }

    function setCue(deck) {
      cuePoints[deck] = (deck === "A" ? wavesurferA : wavesurferB).getCurrentTime();
    }

    function goToCue(deck) {
      (deck === "A" ? wavesurferA : wavesurferB).setTime(cuePoints[deck]);
    }

    function startLoop(deck) {
      let ws = (deck === "A" ? wavesurferA : wavesurferB);
      let startTime = ws.getCurrentTime();
      let endTime = startTime + 4;
      
      stopLoop(deck);
      
      loopIntervals[deck] = setInterval(() => {
        if (ws.getCurrentTime() >= endTime || ws.getCurrentTime() < startTime) {
          ws.setTime(startTime);
        }
      }, 100);
    }

    function stopLoop(deck) {
      if (loopIntervals[deck]) {
        clearInterval(loopIntervals[deck]);
        loopIntervals[deck] = null;
      }
    }

    function setVolume(value, deck) {
      if (deckNodes[deck].gain) {
        deckNodes[deck].gain.gain.value = parseFloat(value);
      }
    }

    function setPitch(value, deck) {
      let ws = (deck === "A" ? wavesurferA : wavesurferB);
      ws.setPlaybackRate(parseFloat(value));
    }

    function setEQ(deck, band, value) {
      if (eqNodes[deck][band]) {
        eqNodes[deck][band].gain.value = parseFloat(value);
      }
    }

    function crossfade(value) {
      if (!audioCtx) return;
      const curve = document.getElementById("curve").value;
      let val = parseFloat(value);
      let gA, gB;

      if (curve === "linear") { gA = 1 - val; gB = val; }
      else if (curve === "exponential") { gA = Math.pow(1 - val, 2); gB = Math.pow(val, 2); }
      else if (curve === "log") { gA = Math.log10((1 - val) * 9 + 1); gB = Math.log10(val * 9 + 1); }
      else { gA = 1 / (1 + Math.exp((val - 0.5) * 10)); gB = 1 - gA; }

      if (deckNodes.A.gain) deckNodes.A.gain.gain.setTargetAtTime(gA, audioCtx.currentTime, 0.01);
      if (deckNodes.B.gain) deckNodes.B.gain.gain.setTargetAtTime(gB, audioCtx.currentTime, 0.01);
    }

    function drawSpectrum(analyser, canvasId) {
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext("2d");
      
      function render() {
        requestAnimationFrame(render);
        
        if (canvas.width !== canvas.clientWidth || canvas.height !== canvas.clientHeight) {
          canvas.width = canvas.clientWidth;
          canvas.height = canvas.clientHeight;
        }

        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        analyser.getByteFrequencyData(dataArray);

        ctx.fillStyle = "#111";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const barWidth = (canvas.width / bufferLength) * 2.5;
        let x = 0;

        for (let i = 0; i < bufferLength; i++) {
          let barHeight = (dataArray[i] / 255) * canvas.height;
          ctx.fillStyle = `rgb(${dataArray[i]}, 255, 255)`;
          ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);
          x += barWidth + 1;
        }
      }
      render();
    }

    function getFXDeck() { return document.getElementById("fxDeck").value; }

    function sweepFilter(deck) {
      if (!audioCtx) return;
      eqNodes[deck].mid.frequency.linearRampToValueAtTime(5000, audioCtx.currentTime + 2);
    }

    function addReverb(deck) {
      if (!audioCtx) return;
      let convolver = audioCtx.createConvolver();
      deckNodes[deck].gain.connect(convolver);
      convolver.connect(audioCtx.destination);
    }

    function addDelay(deck) {
      if (!audioCtx) return;
      let delay = audioCtx.createDelay(5.0);
      delay.delayTime.value = 0.5;
      deckNodes[deck].gain.connect(delay);
      delay.connect(audioCtx.destination);
    }

    let mediaRecorder, chunks = [];
    function startRecording() {
      if (!audioCtx) return;
      const dest = audioCtx.createMediaStreamDestination();
      if (deckNodes.A.gain) deckNodes.A.gain.connect(dest);
      if (deckNodes.B.gain) deckNodes.B.gain.connect(dest);

      chunks = [];
      mediaRecorder = new MediaRecorder(dest.stream);
      mediaRecorder.ondataavailable = e => chunks.push(e.data);
      mediaRecorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'audio/webm' });
        const url = URL.createObjectURL(blob);
        const link = document.getElementById("downloadLink");
        link.href = url;
        link.download = "mixagem.webm";
        link.style.display = "block";
        link.textContent = "⬇️ Baixar Mixagem Gravada";
      };
      mediaRecorder.start();
    }

    function stopRecording() {
      if (mediaRecorder && mediaRecorder.state !== "inactive") {
        mediaRecorder.stop();
      }
    }
  </script>
</body>
</html>
